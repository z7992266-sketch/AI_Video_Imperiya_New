lugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg/1920px-Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1600,"thumbheight":847,"responsiveUrls":{"2":"https://upload.wikimedia.org/wikipedia/commons/b/b3/Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"},"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/b/b3/Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg/1920px-Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1600,"height":847,"srcset":"https://upload.wikimedia.org/wikipedia/commons/b/b3/Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/b/b3/Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Ulugh-Beg-Astronomie-Faksimile-Sternbild-Loewe-Samarkand.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=193200743","extmetadata":{"ImageDescription":{"value":"Close-up of an Arabic manuscript from the exclusive facsimile edition \u201cUlugh Beg \u2013 The Stars of Samarkand.\u201d The photo shows the artistic and scientific depiction of the constellation Leo. The original work was created in the 15th century at the Samarkand Observatory (Uzbekistan) as a commissioned work for Prince Ulugh Beg, based on the corrected and supplemented explanations of the Persian scholar Al-Sufi. The reproduction, published by M\u00fcller &amp; Schindler (Universal Art Group), faithfully presents the findings of Islamic astronomy and the illustrations of historical book illumination.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2022-10-13","source":"commons-desc-page"},"Artist":{"value":"Charlotte Kramer","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""}}}]}}}}