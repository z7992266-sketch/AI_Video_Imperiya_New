# Nusxa oling: cp .env.example .env  (.env faylini HECH QACHON GitHub'ga yuklamang)

# --- OpenRouter ---
OPENROUTER_API_KEY=
# To'g'ri Base URL (oxirida /api/v1 bo'lishi shart):
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Vergul bilan ajratilgan bepul (":free") modellar. Bo'sh qoldirsangiz, bepul modellar avtomatik topiladi.
OPENROUTER_MODELS=

# --- Ovoz (Edge TTS, bepul) ---
TTS_VOICE=uz-UZ-MadinaNeural

# --- Telegram (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- YouTube Shorts (ixtiyoriy, OAuth) ---
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# --- Instagram Reels (ixtiyoriy, Graph API) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
# Video ochiq URL'da turishi kerak (GitHub Actions buni avtomatik to'ldiradi)
VIDEO_PUBLIC_URL=
